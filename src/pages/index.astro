---
import Base from '../layouts/Base.astro';
import Connect from '../components/Connect.astro';
import timeline from '../data/timeline.json';
import projects from '../data/projects.json';
import { site } from '../data/site.js';
import { getCollection } from 'astro:content';

// Counts come from the timeline data, so they stay right as you add entries.
const ventures = timeline.filter((entry) => entry.kind === 'venture').length;
const builds = timeline.filter((entry) => entry.kind === 'software').length;

const posts = (await getCollection('writing', (post) => !post.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const venturesInWords = words[ventures] ?? String(ventures);

const lede =
  `I'm a finance and supply chain student at the University of South Carolina. ` +
  `I've started ${venturesInWords} ventures — among them a faith-based run club in Columbia — ` +
  `and I'm teaching myself to build software. This site is where I keep track of all of it.`;

// Selected projects: featured first, then up to 2 more
const featuredProjects = projects.filter((p) => p.featured).slice(0, 1);
const otherProjects = projects.filter((p) => !p.featured).slice(0, 2);
const selectedProjects = [...featuredProjects, ...otherProjects];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <div class="wide page">
    <section class="intro">
      <div class="intro-rule" aria-hidden="true"></div>
      <h1>I notice what's missing, and build it.</h1>
      <p class="lede">{lede}</p>
      <p class="facts">
        <span>{ventures} ventures</span><span class="sep" aria-hidden="true">/</span><span
          >{builds} software builds</span
        ><span class="sep" aria-hidden="true">/</span><span>{site.location}</span>
      </p>
    </section>

    <section class="block">
      <div class="section-head">
        <h2>Selected projects</h2>
        <a href="/projects/">All projects →</a>
      </div>

      {
        selectedProjects.map((project, index) => {
          const isFeatured = project.featured;
          const tools = project.tools.join(' · ');
          const role = project.role ? `${project.role} · ` : '';
          const meta = role + tools;

          return (
            <article class:list={['project-card', { featured: isFeatured }]}>
              {project.screenshot ? (
                <img src={project.screenshot} alt={`${project.title} screenshot`} class="screenshot" />
              ) : (
                <div class="shot" aria-hidden="true">
                  <span>Screenshot</span>
                </div>
              )}
              <div class="body">
                <p class="eyebrow is-software">Software</p>
                <h3>{project.title}</h3>
                <p class="summary">{project.summary}</p>
                {meta && <p class="meta">{meta}</p>}
                {(project.liveUrl || project.githubUrl) && (
                  <p class="links">
                    {project.liveUrl && <a href={project.liveUrl}>Live site</a>}
                    {project.githubUrl && <a href={project.githubUrl}>GitHub</a>}
                  </p>
                )}
              </div>
            </article>
          );
        })
      }
    </section>

    <section class="block reading">
      <div class="section-head">
        <h2>More</h2>
      </div>
      <ul class="more-list">
        <li>
          <a href="/timeline/">
            <strong>Timeline</strong>
            <span>The full story: {ventures + builds} ventures and builds</span>
          </a>
        </li>
        <li>
          <a href="/ventures/">
            <strong>Ventures &amp; leadership</strong>
            <span>Run With Christ Columbia and {ventures - 1} more</span>
          </a>
        </li>
        <li>
          <a href="/writing/">
            <strong>Writing</strong>
            <span>{posts.length === 0 ? 'Nothing published yet' : `${posts.length} recent posts`}</span>
          </a>
        </li>
      </ul>
    </section>

    <Connect />
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding-bottom: 24px;
  }

  .intro {
    padding-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: var(--column);
  }

  .intro-rule {
    width: 48px;
    height: 2px;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(2.05rem, 1.35rem + 2.8vw, 3.25rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .lede {
    color: var(--muted);
    line-height: 1.65;
    max-width: 38em;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
  }

  .facts .sep {
    color: var(--rule-strong);
  }

  .block {
    margin-top: 72px;
  }

  .reading {
    max-width: var(--column);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .project-card.featured {
    padding-bottom: 36px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 36px;
  }

  .project-card:not(.featured) {
    margin-bottom: 32px;
  }

  .screenshot,
  .shot {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
  }

  h3 {
    font-size: clamp(1.3125rem, 1.1rem + 0.8vw, 1.5rem);
    color: var(--ink);
  }

  .project-card.featured h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  }

  .summary {
    font-size: 1rem;
    color: var(--ink-soft);
  }

  .meta {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-weight: 500;
  }

  .more-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .more-list li {
    border-top: 1px solid var(--rule);
  }

  .more-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .more-list a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 0;
    color: var(--ink);
  }

  .more-list a:hover {
    text-decoration: none;
  }

  .more-list a:hover strong {
    color: var(--accent);
  }

  .more-list strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.1875rem;
  }

  .more-list span {
    font-size: 1rem;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .page {
      gap: 88px;
    }

    .intro {
      padding-top: 72px;
      gap: 22px;
    }

    .block {
      margin-top: 104px;
    }

    .project-card.featured {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 48px;
      align-items: center;
      padding-bottom: 48px;
      margin-bottom: 48px;
    }

    .project-card:not(.featured) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      align-items: start;
    }

    .more-list li {
      padding: 24px 0;
    }

    .more-list strong {
      font-size: 1.375rem;
    }
  }
</style>
