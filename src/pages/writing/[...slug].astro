---
// One page per post. Astro builds a page for every file in src/content/writing.
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', (post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={post.data.title} description={post.data.summary}>
  <article class="column post">
    <header>
      <span class="eyebrow">{post.data.tag} · {date}</span>
      <h1>{post.data.title}</h1>
    </header>
    <div class="body">
      <Content />
    </div>
    <a class="back" href="/writing/">← All writing</a>
  </article>
</Base>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 40px 0 24px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h1 {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.5rem);
  }

  /* Styles for the post's own text, which comes from Markdown. */
  .body {
    display: flex;
    flex-direction: column;
    gap: 1.1em;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .body :global(h2) {
    margin-top: 0.8em;
    font-size: 1.5rem;
    color: var(--ink);
  }

  .body :global(h3) {
    margin-top: 0.4em;
    font-size: 1.25rem;
    color: var(--ink);
  }

  .body :global(img) {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .body :global(blockquote) {
    margin: 0;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    font-family: var(--serif);
    font-style: italic;
  }

  .body :global(code) {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--paper-deep);
    font-size: 0.9em;
  }

  .back {
    font-size: 1rem;
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .post {
      padding-top: 64px;
    }

    .body {
      font-size: 1.25rem;
    }
  }
</style>
