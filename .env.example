# Copy this file to .env and paste your Notion secret after NOTION_TOKEN=
# .env is listed in .gitignore, so the secret never leaves your computer.
NOTION_TOKEN=

# Which Notion databases to read (the "Timeline" and "Writing" data sources).
NOTION_TIMELINE_ID=308ad9c7-6c69-447a-ba4f-59551a512a36
NOTION_WRITING_ID=bc8a4ae3-799a-4c2b-bea5-99317e34bc60
